  definition:
    Id: client_scope_creep
    Title: The client wants one more feature, urgently
    Body: The client calls asking for one extra piece. They say it is not big.
    BaseSuccessChance: 0.55
    OnAcceptSuccess:
      ProgressDelta: 15
      CredibilityDelta: 0
      DeadlineDelta: 0
      TeamFatigueDelta: 0
      TeamMoraleDelta: 0
      Text: The team lands it in time and the client is delighted.
    OnAcceptFail:
      ProgressDelta: -8
      CredibilityDelta: -10
      DeadlineDelta: 0
      TeamFatigueDelta: 0
      TeamMoraleDelta: 0
      Text: The scope blew up and finished work had to be torn out.
    OnDecline:
      ProgressDelta: 0
      CredibilityDelta: 0
      DeadlineDelta: -1
      TeamFatigueDelta: 0
      TeamMoraleDelta: 0
      Text: The client is unhappy and pulls the deadline in.
    WarningLeadTurns: 0
