  definition:
    Id: untested_shortcut
    Title: Someone proposes a shortcut nobody has tried
    Body: A team member suggests a new approach that could save a lot of time, but
      no one has used it before.
    BaseSuccessChance: 0.45
    OnAcceptSuccess:
      ProgressDelta: 18
      CredibilityDelta: 0
      DeadlineDelta: 0
      TeamFatigueDelta: 0
      TeamMoraleDelta: 6
      Text: The new approach works and the person who proposed it is beaming.
    OnAcceptFail:
      ProgressDelta: -10
      CredibilityDelta: -12
      DeadlineDelta: 0
      TeamFatigueDelta: 0
      TeamMoraleDelta: 0
      Text: It broke, and the time is gone for nothing.
    OnDecline:
      ProgressDelta: 0
      CredibilityDelta: 0
      DeadlineDelta: 0
      TeamFatigueDelta: 0
      TeamMoraleDelta: -8
      Text: They went quiet. They probably will not propose anything next time.
    WarningLeadTurns: 0
